<templates>
    <t t-name="pos_digital_refund.DigitalRefundPopup" owl="1">
        <style>
            /* Estilos generales del popup */
            .digital-refund-popup .popup {
                width: 400px;
                max-width: 90vw;
                background: white;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
                overflow: hidden;
            }
            
            .digital-refund-popup .popup-title {
                background: #8d4083;
                color: white;
                padding: 20px;
                text-align: center;
                font-size: 18px;
                font-weight: 600;
                margin: 0;
            }
            
            .digital-refund-popup .popup-body {
                padding: 25px;
                background: #f8f9fa;
            }
            
            /* Estilos de formulario */
            .digital-refund-popup .form-group {
                margin-bottom: 20px;
            }
            
            .digital-refund-popup .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #2d3748;
                font-size: 14px;
            }
            
            .digital-refund-popup .form-control {
                width: 100%;
                padding: 12px 15px;
                border: 2px solid #e2e8f0;
                border-radius: 8px;
                font-size: 14px;
                transition: all 0.3s ease;
                background: white;
                box-sizing: border-box;
            }
            
            .digital-refund-popup .form-control:focus {
                outline: none;
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }
            
            .digital-refund-popup .form-control:hover {
                border-color: #cbd5e0;
            }
            
            /* Estilos de botones */
            .digital-refund-popup .popup-footer {
                display: flex;
                gap: 12px;
                padding: 20px;
                background: white;
                border-top: 1px solid #e2e8f0;
            }
            
            .digital-refund-popup .btn {
                flex: 1;
                padding: 12px 20px;
                border: none;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
                font-size: 14px;
            }
            
            .digital-refund-popup .btn-cancel {
                background: #f7fafc;
                color: #4a5568;
                border: 2px solid #e2e8f0;
            }
            
            .digital-refund-popup .btn-cancel:hover {
                background: #edf2f7;
                border-color: #cbd5e0;
            }
            
            .digital-refund-popup .btn-confirm {
                background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
                color: white;
            }
            
            .digital-refund-popup .btn-confirm:hover {
                background: linear-gradient(135deg, #38a169 0%, #2f855a 100%);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(72, 187, 120, 0.3);
            }
            
            /* Efectos de focus para accesibilidad */
            .digital-refund-popup .btn:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3);
            }
            
            /* Responsive */
            @media (max-width: 480px) {
                .digital-refund-popup .popup {
                    width: 95vw;
                    margin: 10px;
                }
                
                .digital-refund-popup .popup-body {
                    padding: 20px 15px;
                }
                
                .digital-refund-popup .popup-footer {
                    flex-direction: column;
                    gap: 10px;
                }
            }
        </style>

        <div class="popup digital-refund-popup">
            <div class="popup-title">
                <t t-esc="props.title"/>
            </div>
            <div class="popup-body">
                <div class="form-group">

                    <label>Banco</label>
                    <select t-model="state.bank" class="form-control">
                        <option value="">Seleccione un banco</option>
                        <option value="0102">0102 - BANCO DE VENEZUELA</option>
                        <option value="0104">0104 - BANCO VENEZOLANO DE CREDITO</option>
                        <option value="0105">0105 - BANCO MERCANTIL</option>
                        <option value="0108">0108 - BBVA PROVINCIAL</option>
                        <option value="0114">0114 - BANCARIBE</option>
                        <option value="0115">0115 - BANCO EXTERIOR</option>
                        <option value="0128">0128 - BANCO CARONI</option>
                        <option value="0134">0134 - BANESCO</option>
                        <option value="0137">0137 - BANCO SOFITASA</option>
                        <option value="0138">0138 - BANCO PLAZA</option>
                        <option value="0146">0146 - BANGENTE</option>
                        <option value="0151">0151 - BANCO FONDO COMUN</option>
                        <option value="0156">0156 - 100% BANCO</option>
                        <option value="0157">0157 - DELSUR BANCO UNIVERSAL</option>
                        <option value="0163">0163 - BANCO DEL TESORO</option>
                        <option value="0168">0168 - BANCRECER</option>
                        <option value="0169">0169 - R4 BANCO MICROFINANCIERO C.A.</option>
                        <option value="0171">0171 - BANCO ACTIVO</option>
                        <option value="0172">0172 - BANCAMIGA BANCO UNIVERSAL, C.A.</option>
                        <option value="0173">0173 - BANCO INTERNACIONAL DE DESARROLLO</option>
                        <option value="0174">0174 - BANPLUS</option>
                        <option value="0175">0175 - BANCO DIGITAL DE LOS TRABAJADORES, BANCO UNIVERSAL</option>
                        <option value="0177">0177 - BANFANB</option>
                        <option value="0178">0178 - N58 BANCO DIGITAL BANCO MICROFINANCIERO S A</option>
                        <option value="0191">0191 - BANCO NACIONAL DE CREDITO</option>
                    </select>

                </div>
                <div class="form-group">
                    <label>Cédula/RIF</label>
                    <input type="text" t-model="state.idNumber" class="form-control" placeholder="Ej: V12345678"/>
                </div>
                <div class="form-group">
                    <label>Teléfono Destino</label>
                    <input type="text" t-model="state.phone" class="form-control" placeholder="Ej: 04121234567"/>
                </div>
                <div class="form-group">
                    <label>Monto a Devolver</label>
                    <input type="number" t-model="state.amount" class="form-control" step="0.01" min="0"/>
                </div>
            </div>
            <div class="popup-footer">
                <button class="btn btn-cancel" t-on-click="cancel">Cancelar</button>
                <button class="btn btn-confirm" t-on-click="confirm">Confirmar</button>
            </div>
        </div>
    </t>
</templates>