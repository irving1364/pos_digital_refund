<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_digital_refund_tree" model="ir.ui.view">
        <field name="name">digital.refund.tree</field>
        <field name="model">digital.refund</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="create_date"/>
                <field name="pos_order_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="reference"/>
            </tree>
        </field>
    </record>

    <record id="view_digital_refund_form" model="ir.ui.view">
        <field name="name">digital.refund.form</field>
        <field name="model">digital.refund</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="reference" readonly="1"/>
                    </group>
                    <group>
                        <field name="pos_order_id" readonly="1"/>
                        <field name="amount"  readonly="1"/>
                        <field name="invoice_number"  readonly="1"/>
                        <field name="config_id"  readonly="1"/>
                    </group>
                    <group>
                        <field name="response" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button name="action_process_refund" 
                                type="object" 
                                string="Procesar Vuelto" 
                                class="btn-primary"
                        />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_digital_refund" model="ir.actions.act_window">
        <field name="name">Vueltos Digitales</field>
        <field name="res_model">digital.refund</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

     <menuitem id="menu_digital_refund" 
              name="Vueltos Digitales"
              parent="point_of_sale.menu_pos_dashboard"  
              action="action_digital_refund"
              sequence="20"/>
</odoo>