<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Heredamos y extendemos la vista existente -->
    <record id="view_encrypted_data_form_extended" model="ir.ui.view">
        <field name="name">encrypted.data.form.extended</field>
        <field name="model">encrypted.data</field>
        <field name="inherit_id" ref="tu_modulo_actual.view_encrypted_data_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='encrypted_key']" position="after">
                <group string="Configuración API Vuelto Digital">
                    <field name="api_url_refund" string="URL API Vuelto"/>
                    <field name="default_destination_id" string="ID Destino Predeterminado"/>
                    <field name="default_destination_mobile" string="Móvil Destino Predeterminado"/>
                    <field name="default_origin_mobile" string="Móvil Origen Predeterminado"/>
                    <field name="default_twofactor_auth" string="Autenticación Two-Factor"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Mantenemos los elementos existentes -->
    <record id="action_encrypted_data_server" model="ir.actions.server">
        <field name="name">Abrir Configuración Encriptada</field>
        <field name="model_id" ref="model_encrypted_data"/>
        <field name="binding_model_id" ref="model_encrypted_data"/>
        <field name="state">code</field>
        <field name="code">
            action = model.action_open_config()
        </field>
    </record>

    <menuitem id="menu_encrypted_data_root" name="Datos Encriptados"/>
    
    <menuitem 
        id="menu_encrypted_data" 
        name="Configurar Datos Encriptados" 
        parent="menu_encrypted_data_root" 
        action="action_encrypted_data_server"
    />
</odoo>